{
    "tabWidth": 4,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 120,
    "overrides": [
        {
            "files": ["*.yaml", "*.yml", "*.html", "package.json", "package-lock.json"],
            "options": {
                "tabWidth": 2,
                "useTabs": false
            }
        }
    ]
}
