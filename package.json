{
    "name": "procedural-map",
    "version": "1.0.0",
    "description": "procedural map creation",
    "main": "index.js",
    "scripts": {
        "mocha": "mocha",
        "test": "run-s compile-ts mocha",
        "compile-ts": "tsc --types node --module commonjs classes.ts",
        "ts-watch": "tsc --types node --module commonjs -w classes.ts",
        "start": "run-s compile-ts start-server",
        "start-server": "node index.js",
        "dev-server": "nodemon",
        "dev": "run-p ts-watch dev-server",
        "build-test-start": "run-s compile-ts mocha start-server"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/levg34/procedural-map.git"
    },
    "author": "levg34",
    "license": "SEE LICENSE IN LICENSE",
    "bugs": {
        "url": "https://github.com/levg34/procedural-map/issues"
    },
    "homepage": "https://github.com/levg34/procedural-map#readme",
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/three": "^0.187.0",
        "mocha": "^9.0.1",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.10.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "express": "^4.17.1",
        "three": "^0.129.0"
    }
}
