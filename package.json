{
    "name": "procedural-map",
    "version": "1.0.0",
    "description": "procedural map creation",
    "main": "index.js",
    "scripts": {
        "vitest": "vitest run",
        "test": "run-s compile-ts vitest",
        "compile-ts": "tsc --types node --module commonjs classes.ts",
        "ts-watch": "tsc --types node --module commonjs -w classes.ts",
        "build": "vite build",
        "vite": "vite",
        "start": "run-s compile-ts build start-server",
        "start-server": "node index.js",
        "dev-server": "nodemon --watch index.js --watch classes.js --watch utils.js --watch roadData.js index.js",
        "dev": "run-p ts-watch dev-server vite",
        "build-test-start": "run-s compile-ts vitest build start-server"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/levg34/procedural-map.git"
    },
    "author": "levg34",
    "license": "SEE LICENSE IN LICENSE",
    "bugs": {
        "url": "https://github.com/levg34/procedural-map/issues"
    },
    "homepage": "https://github.com/levg34/procedural-map#readme",
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/three": "^0.187.0",
        "nodemon": "^3.1.14",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.10.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "express": "^4.17.1",
        "three": "^0.187.0"
    }
}
